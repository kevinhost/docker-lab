# web:1.0 : le "build Angular" (index.html) servi par nginx, avec le reverse proxy
# vers http://api:8080/ (nom resolu par le Service "api" du cluster).
FROM docker.io/library/nginx:alpine
COPY nginx-proxy.conf /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/index.html
EXPOSE 80
